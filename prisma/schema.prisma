// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum TaskStatus {
  open
  claimed
  in_progress     @map("in-progress")
  pending_verification
  approved
  rejected
  completed
  expired
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum TaskType {
  sync
  async
}

enum PayoutStatus {
  pending
  processing
  paid
  failed
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Task {
  id               String       @id @default(cuid())
  title            String
  description      String
  context          String?
  status           TaskStatus   @default(open)
  priority         TaskPriority @default(medium)
  taskType         TaskType     @default(async)

  // Rewards
  rewardAmount     Float?
  rewardCurrency   String?

  // Time limits
  estimatedMins    Int?         // estimated work duration in minutes
  claimTimeoutMins Int          @default(5)   // minutes a claim holds without submission
  completionMins   Int?         // minutes to complete after claiming (null = no hard deadline)
  expiresAt        DateTime?    // hard expiry while open — task auto-cancels

  // Lifecycle timestamps
  claimedAt          DateTime?
  claimExpiresAt     DateTime?  // claimedAt + claimTimeoutMins
  completionDeadline DateTime?  // claimedAt + completionMins

  // Assignment
  postedBy         String
  assignedTo       String?
  autoReassign     Boolean      @default(true)
  reassignCount    Int          @default(0)

  // Results
  result           String?
  verificationNote String?
  paidOut          Boolean      @default(false)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  earnings EarningEntry[]
}

model EarningEntry {
  id        String   @id @default(cuid())
  userId    String
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  taskTitle String
  amount    Float
  currency  String   @default("USD")
  earnedAt  DateTime @default(now())
  paidOut   Boolean  @default(false)
}

model PayoutRequest {
  id             String       @id @default(cuid())
  userId         String
  amount         Float
  currency       String       @default("USD")
  status         PayoutStatus @default(pending)
  stripePayoutId String?
  createdAt      DateTime     @default(now())
}

model WorkerStat {
  id                 String   @id @default(cuid())
  userId             String   @unique
  totalClaimed       Int      @default(0)
  totalCompleted     Int      @default(0)
  totalApproved      Int      @default(0)
  totalRejected      Int      @default(0)
  totalExpired       Int      @default(0)  // timed out without submitting
  avgCompletionSecs  Float?
  reliabilityScore   Float    @default(1.0) // 0–1 composite score
  updatedAt          DateTime @updatedAt
}
